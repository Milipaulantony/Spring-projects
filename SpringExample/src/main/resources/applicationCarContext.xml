<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="CarSpec" class="car.example.constructor.injection.Car_Specifics">
        <property name="make_of_car" value="Honda"/>
        <property name="model_of_car" value="CRV"/>
    </bean>

    <bean id="MyCar" class="car.example.constructor.injection.Car">
        <constructor-arg ref="CarSpec"/>
    </bean>

</beans>