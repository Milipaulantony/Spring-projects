<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="DB" class="com.spring.loose.coupling.UserDatabaseProvider">
    </bean>

    <bean id="WS" class="com.spring.loose.coupling.WebServiceDataProvider">
    </bean>

    <bean id="NewDB" class="com.spring.loose.coupling.NewDBProvider">
    </bean>

    <bean id="DBMgr" class="com.spring.loose.coupling.UserManager">
        <constructor-arg ref="DB"/>
    </bean>

    <bean id="WSMgr" class="com.spring.loose.coupling.UserManager">
        <constructor-arg ref="WS"/>
    </bean>

    <bean id="NewDBMgr" class="com.spring.loose.coupling.UserManager">
        <constructor-arg ref="NewDB"/>
    </bean>



</beans>